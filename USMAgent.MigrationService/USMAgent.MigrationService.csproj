	<ItemGroup>
		<ProjectReference Include="..\USMAgent.Infrastructure\USMAgent.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Seed\seed.sql" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
